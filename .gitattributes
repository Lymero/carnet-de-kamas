# Normalise line endings to LF in the repository and working tree, on every OS.
* text=auto eol=lf
# Windows batch files are parsed most reliably with CRLF line endings.
*.cmd text eol=crlf

# Generated by scripts/build_catalog.py: collapsed in GitHub diffs, still diffable locally.
src/data/dofus-data.json linguist-generated=true

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
