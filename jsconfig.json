{
  // Type-checks the browser code from its JSDoc annotations (npm run typecheck). Nothing is emitted:
  // the browser still loads the source files as they are.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/js/**/*.js"]
}
